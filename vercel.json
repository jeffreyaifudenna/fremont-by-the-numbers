{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.fremontcabythenumbers.com" }],
      "destination": "https://fremontcabythenumbers.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(css|js|data)/(.*)",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
